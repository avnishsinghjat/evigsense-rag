############
# Supabase self-hosted (copy to docker/.env)
############
POSTGRES_PASSWORD=your-super-secret-postgres-password
# Regenerate keys after changing JWT_SECRET: node scripts/generate-jwt-keys.mjs "$JWT_SECRET"
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzc5NTU4MjQxLCJleHAiOjE5MzcyMzgyNDF9.eQlWtme6LS0_ES6V6WJV-_ov3aaYxw4QG6G2gzOeNgM
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UiLCJpYXQiOjE3Nzk1NTgyNDEsImV4cCI6MTkzNzIzODI0MX0.nbV8hYj-O4_a3onyBFzvNo5El5hih0Y2NDF0mlZrj5o

SITE_URL=http://localhost:8080
API_EXTERNAL_URL=http://localhost:8000
SUPABASE_PUBLIC_URL=http://localhost:8000

############
# LM Studio (edge functions reach host via host.docker.internal)
############
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
LMSTUDIO_API_KEY=lm-studio
# Set these to the exact model IDs LM Studio exposes — check http://localhost:1234/v1/models
# Examples below match the EVIGSENSE reference stack (Qwen3 chat + Qwen3 embeddings + Chandra OCR VLM)
LMSTUDIO_CHAT_MODEL=qwen/qwen3.6-35b-a3b
# Optional dedicated translator (falls back to LMSTUDIO_CHAT_MODEL). Use a smaller/faster model for RU→EN.
LMSTUDIO_TRANSLATE_MODEL=google/gemma-4-e4b
LMSTUDIO_EMBED_MODEL=text-embedding-qwen3-embedding-0.6b
# Must equal the embed model's output dim. bge-m3 and Qwen3-Embedding-0.6B are both 1024.
EMBEDDING_DIM=1024

############
# OCR (Chandra)
############
OCR_BACKEND=lmstudio
OCR_MODEL=chandra-ocr-2
# Reasoning OCR models (chandra-ocr-2, etc.) need a big token budget for
# chain-of-thought + final markdown. 16k handles dense single pages.
OCR_MAX_TOKENS=16384
# Optional reasoning effort hint forwarded to LM Studio: "low" | "medium" | "high".
OCR_REASONING_EFFORT=low
CHANDRA_BASE_URL=http://host.docker.internal:8001

############
# Audio transcription
############
AUDIO_BACKEND=disabled
WHISPER_BASE_URL=http://host.docker.internal:1234/v1
WHISPER_MODEL=whisper-1

############
# Internal function auth
############
INTERNAL_FUNCTION_SECRET=change-me-to-a-random-secret
